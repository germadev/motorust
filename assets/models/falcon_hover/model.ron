// The hover version of `falcon`, by its folder: `falcon_hover`.
// Made with Meshy and prepared by tools/import_hoverbike.py, which measured
// it: the middles of its pads (its axles) and how big they are, and where
// its grips, pegs and seat are (m, in the bike's space); it hovers, its pads
// casting a light of the colour of `glow` on the road; its lights are in
// emissive.jpg; and its rider is `falcon`'s.
(
    geometry: (
        front_axle: (0, 0.277, -0.5561),
        rear_axle: (0, 0.2549, 0.5523),
        front_radius: 0.2561,
        rear_radius: 0.2518,
        steering_head: (0, 0.7762, -0.4091),
        grip: (0.2621, 0.7162, -0.3591),
        peg: (0.16, 0.3834, 0.245),
        seat: (0, 0.9334, 0.175),
    ),
    steers: false,
    hover: Some((glow: (0.25, 0.6369, 1))),
    rider: Some("falcon"),
    emissive: true,
)
