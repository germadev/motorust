// The Cobra XT, orange.
// Made with Meshy and prepared by tools/import_models.py, which measured
// it: where its axles, steering head, grips, pegs and seat are (m, in the
// bike's space) and how big its wheels are (the Shogun's by hand, the
// script's reference for the others); whether its fork and bars turn with
// the steering; and the slicks it wears (Soft, Medium or Hard).
(
    geometry: (
        front_axle: (0.0, 0.281, -0.7),
        rear_axle: (0.0, 0.3063, 0.68),
        front_radius: 0.2901,
        rear_radius: 0.3063,
        steering_head: (0.0, 0.8891, -0.3867),
        grip: (0.2891, 0.8138, -0.3693),
        peg: (0.16, 0.3236, 0.295),
        seat: (0.0, 0.8736, 0.225),
    ),
    steers: true,
    tyres: Hard,
)
