// Las motos de la carrera, in the order of the bike select screen: the one
// the player chooses starts from their place on the grid, the others take,
// in order, the rivals' places. One for each place on the grid (eight).
//
// Each: its name and description (Spanish and English), the colour of its
// name on the start screen and of its dot on the minimap (sRGB), its design
// (the models made with Meshy, each with its rider: Shogun, Legend, Azura,
// Kraken, Falcon, Stiletto, Cobra, Ronin; or those built in code: Afilada,
// Escudo, Alerones, Rombo) and its livery, by name (only those built in code
// show it: cover, flecha, diagonal, verde, tricolor, rosso; see
// src/bike/model/livery.rs).
[
    (
        name: "Shogun TZ",
        description: "Azul y blanca, como la de la portada de Moto Racer",
        description_en: "Blue and white, like the Moto Racer cover",
        color: (0.35, 0.6, 1.0),
        design: Shogun,
        livery: "cover",
