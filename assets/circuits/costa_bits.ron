        water: Sea,
        // The ground as voxels, in blocks of one colour, 1 m on a side by the
        // roads and up to 8 m far off, cut to a palette of 12 shades of each of
        // red, green and blue; the trees as flat sprites of pixel art facing the
        // camera (the engine's `Look::Voxel`).
        look: Voxel(size: 1.0, shades: Some(12)),
    ),
)
