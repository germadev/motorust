            (1834.0, 16.5),
            (1956.0, 21.0),
            (2042.0, 27.0),
            (2154.0, 36.0),
            (2274.0, 44.5),
            (2394.0, 51.0),
            // The summit, some 56 m up, on a straight: flat out, the bike takes
            // off over it and lands well before the bends down to the cape.
            (2465.0, 54.0),
            (2500.0, 56.0),
            (2535.0, 53.0),
            (2580.0, 50.5),
            (2634.0, 49.5),
            // Down round the cape, the lighthouse below, and off the mountain to
            // the south coast.
            (2756.0, 43.0),
            (2868.0, 35.0),
            (2972.0, 27.5),
            (3070.0, 20.0),
            (3168.0, 14.0),
            (3258.0, 10.5),
            (3350.0, 8.5),
            (3438.0, 8.0),
            (3516.0, 8.0),
            (3576.0, 8.2),
            (3672.0, 8.0),
            (3752.0, 7.4),
            // Down to the chicane and the start straight.
            (3802.0, 5.6),
            (3840.0, 4.0),
            (3876.0, 2.6),
            (3922.0, 1.2),
            (3974.0, 0.5),
            (4030.0, 0.2),
        ],
        wall: 11.5,
    ),
    scenery: (
        // The land round the bay, its mouth open to the sea to the south under
