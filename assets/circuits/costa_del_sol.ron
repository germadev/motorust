// Costa del Sol: a sunset run round a bay of the Andalusian coast. The lap
// goes clockwise round the bay, the water always on the right, and closes
// over a bridge across its mouth.
//
// 1. Salida / Recta costera: the start straight runs north along the bay's
//    west shore, a railing, palms and the water on the right, the town's
//    whitewashed houses on the left.
// 2. Curvas del acantilado: S-bends climbing north up the cliffs, cut rock
//    on the left, the bay below on the right, to some 27 m.
// 3. Túnel de la montaña: round to the east at the head of the bay, and
//    through the mountain behind it in a tunnel.
// 4. Out of the tunnel, south down the bay's east shore, and east over the
//    headland through a pine forest to the open sea.
// 5. Carretera de la sierra: a mountain road south up the cliffs over the
//    open sea, cut rock on the right, a stone parapet over the drop on the
//    left, to a summit some 56 m up, on a straight, where the bike takes
//    off; then down in bends round the cape, the lighthouse far below, and
//    off the mountain west along the south coast.
// 6. Puente costero: a bridge over the bay's mouth heading west, the open
//    sea on the left and the bay on the right.
// 7. Chicane final: off the bridge, left, right and left again, and round
//    to the right onto the start straight.
//
// Where things are, in metres from the finish line:
//
// - the start straight:      Span(3950.0, 340.0), a crest at 155 m
// - the cliffs:              Span(380.0, 930.0)
// - the tunnel:              Span(985.0, 1150.0)
// - the east shore:          Span(1230.0, 1540.0)
// - over the headland:       Span(1540.0, 2040.0), through the forest
// - up the mountain road:    Span(2040.0, 2500.0), the summit at 2500 m
// - down round the cape:     Span(2540.0, 3260.0), the lighthouse at (830.0, 540.0)
// - the bridge:              Span(3592.0, 3762.0)
// - the chicane:             Span(3792.0, 3932.0)
//
// How a circuit's file is written: see the engine's src/circuits/data.rs.
(
    name: "Costa del Sol",
    name_en: "Costa del Sol",
    description: "Al atardecer, en pixel art: acantilados, un túnel,\nuna carretera de montaña y un puente sobre el mar",
    description_en: "A sunset run in pixel art: cliffs, a tunnel,\na mountain road and a bridge over the sea",
    // A bay at sunset: the sea and its gulls, the cicadas still singing.
    ambience: (
        sea: 0.85,
        gulls: 0.6,
        birds: 0.2,
        cicadas: 0.35,
        wind: 0.25,
    ),
    song: (file: "crown_of_the_track.mp3", length: 172.9, loudness: -14.4),
    pace: 1.0,
    layout: (
        control_points: [
            // 1. The start straight, north (-Z) along the bay's west shore.
            (0.0, 0.0),
            (0.0, -100.0),
            (0.0, -200.0),
            (0.0, -300.0),
            // 2. The cliffs: S-bends climbing north, the bay on the right.
            (-12.0, -380.0),
            (-40.0, -450.0),
            (-45.0, -520.0),
            (-20.0, -585.0),
            (10.0, -640.0),
            (15.0, -705.0),
            (0.0, -770.0),
            // 3. Round to the east at the head of the bay, and through the
            //    mountain.
            (20.0, -835.0),
            (70.0, -870.0),
            (140.0, -880.0),
            (220.0, -878.0),
            (300.0, -870.0),
            // 4. Out of the tunnel, round to the south and down the east shore.
            (370.0, -845.0),
            (420.0, -790.0),
            (440.0, -720.0),
            (445.0, -630.0),
            // 5. Off the bay's shore, east over the headland to the open sea.
            (470.0, -565.0),
            (520.0, -525.0),
            (600.0, -505.0),
            (690.0, -495.0),
            (780.0, -470.0),
            (850.0, -420.0),
            // 6. The mountain road: south up the cliffs over the open sea, on the
            //    left.
            (880.0, -340.0),
            (890.0, -230.0),
            (892.0, -110.0),
            (890.0, 10.0),
            (885.0, 130.0),
            (875.0, 250.0),
            // Round the cape with the lighthouse, and back west to the bridge.
            (850.0, 370.0),
            (800.0, 470.0),
            (720.0, 535.0),
            (625.0, 555.0),
            (530.0, 535.0),
            (460.0, 480.0),
            (415.0, 400.0),
            (390.0, 315.0),
            (370.0, 240.0),
            (335.0, 192.0),
            (240.0, 190.0),
            (160.0, 190.0),
            // 5. The chicane, and round to the right onto the start straight,
