            (110.0, 188.0),
            (75.0, 200.0),
            (40.0, 195.0),
            (10.0, 160.0),
            (0.0, 110.0),
            (0.0, 55.0),
        ],
        // Over a crest on the start straight, up the cliffs to the tunnel, some
