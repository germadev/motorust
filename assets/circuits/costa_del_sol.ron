            spans: [Span(2600.0, 340.0), Span(1800.0, 2050.0)],
            style: Cottage,
        ),
        palms: [
            (span: Span(2600.0, 340.0), side: Right, lateral: 15.5, every: 24.0),
            (span: Span(2600.0, 340.0), side: Left, lateral: 17.0, every: 36.0),
            (span: Span(1900.0, 2200.0), side: Right, lateral: 15.5, every: 30.0),
        ],
        buoys: [(120.0, -150.0), (200.0, -520.0), (300.0, -250.0), (230.0, 200.0)],
