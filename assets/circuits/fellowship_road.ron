            (2364.1, 1.1),
            (2714.1, 13.1),
            // Up Caradhras at up to 12 %, to the pass right over the mines.
            (2899.1, 21.0),
            (2999.1, 30.0),
            (3099.1, 39.0),
            (3159.1, 45.5),
            (3199.1, 47.5),
            // Down round the mountain to the Doors of Durin; through Moria, down
