            (368.7, 353.7),
            (337.8, 348.2),
            (306.5, 344.9),
            (275.1, 343.8),
            // 12. Past the lake, round to the right over the shoulder of Amon Hen
            // onto the start straight, back in the Shire.
            (235.2, 343.8),
            (204.5, 341.8),
            (174.3, 335.8),
            (145.2, 325.9),
            (117.6, 312.3),
            (92.0, 295.2),
