            (1959.1, 38.0),
            (2049.1, 27.5),
            (2139.1, 17.0),
            (2229.1, 7.0),
            (2299.1, 3.0),
            (2339.1, 0.5),
            // Climbing steadily through Rivendell's split (as Ghost Island's
