            (span: Span(4322.0, 4880.0), side: Right, style: Stone),
            (span: Lap, side: Left, style: Timber),
            (span: Lap, side: Right, style: Timber),
        ],
        tunnels: [Span(360.0, 620.0)],
        // The shrine's boardwalk, planks on piers across the inlet, low over
