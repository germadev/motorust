            // slope, not in a wall of rock).
            (span: Span(420.0, 730.0), side: Left, height: 16.0),
            (span: Span(420.0, 730.0), side: Right, height: 16.0),
        ],
        // The clearing under the great maple, on a knoll rising from the road
        // beside it, tilted up away from it, so that the tree stands high and
        // its carpet of leaves faces the riders; and the fishing village's
        // farmhouses raised a little over the coast road climbing past them,
        // so that they show over its wall.
        terraces: [
            // The top of the great torii's islet, level for it to stand on, a
            // little under the road.
            (center: (497.0, -892.0), radius: 10.0, height: 5.5, skirt: 5.0),
            // The pagoda's ground before the corridor of torii, a little over
            // the road, so that it stands out as the riders come up at it.
            (center: (727.9, -126.5), radius: 10.0, height: 25.0, skirt: 10.0),
            // The shrine in the bamboo, a little over the road.
            (center: (-98.9, -305.5), radius: 12.0, height: 41.0, skirt: 10.0),
            (center: (875.4, 479.9), radius: 16.0, height: 9.0, tilt: (0.002, 0.15), skirt: 40.0),
            (center: (96.6, -760.7), radius: 7.0, height: 9.0, skirt: 10.0),
            (center: (154.0, -774.4), radius: 7.0, height: 10.9, skirt: 10.0),
            (center: (213.2, -764.5), radius: 7.0, height: 12.0, skirt: 10.0),
        ],
        // Across the sea: the volcano to the north, a lone cone with its
        // flanks sweeping up ever steeper to a crater at its top, and lower
        // mountains round the rest of the horizon, clear of it.
        mountains: "ghost_island_mountains",
        // Vermilion and white.
        curbs: [(0.86, 0.2, 0.09), (0.95, 0.94, 0.9)],
        // Stone walls along the castle street, the coast and the castle
        // ridge, a hedge round the lake, and timber everywhere else.
        walls: [
            // The wall opens into the shrine's vermilion fence on its own
