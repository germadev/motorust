                (models: [StoneLantern, BronzeLantern], row: (span: Span(2700.0, 3400.0), side: Right, lateral: 12.8, every: 85.0)),
                // Up the red ridge: braziers and memorial stones, and guardians in
                // twos, one either side, as at the foot of the corridor of torii.
                (models: [Brazier, Stele], row: (span: Span(3764.0, 4322.0), side: Left, lateral: 12.8, every: 110.0)),
                (models: [Komainu], row: (span: Span(3764.0, 4322.0), side: Left, lateral: 12.8, every: 150.0)),
                (models: [Komainu], row: (span: Span(3764.0, 4322.0), side: Right, lateral: 12.8, every: 150.0)),
                // Down the castle ridge, lit for the night.
                (models: [Brazier, Komainu, Stele], row: (span: Span(4322.0, 4880.0), side: Left, lateral: 12.8, every: 95.0)),
                (models: [Brazier, Hokora], row: (span: Span(4369.0, 4880.0), side: Right, lateral: 12.8, every: 95.0)),
                // Down through the bamboo, where the jizō stand: a shrine and a stone
                // among them, one side half a step after the other.
                (models: [Jizo, Hokora], row: (span: Span(4880.0, 5675.0), side: Left, lateral: 12.8, every: 140.0)),
                (models: [Jizo, Stele], row: (span: Span(4950.0, 5675.0), side: Right, lateral: 12.8, every: 140.0)),
            ],
            // Under the great maple, beside the road round the foot of the
            // lake.
            maple_grounds: [(center: (875.4, 479.9), radius: 14.0)],
            // Red maple leaves blowing down up the red ridge, through the
            // corridor of torii, and round the great maple; white cherry
            // petals down the castle street.
            petals: [
                (area: Road(span: Span(3764.0, 4322.0), reach: 24.0), kind: Maple),
                (area: Round(center: (875.4, 479.9), radius: 36.0), kind: Maple),
                // Blowing over the whole bend round the foot of the lake,
                // along the great maple's clearing.
                (area: Round(center: (956.8, 422.0), radius: 32.0), kind: Maple),
                (area: Round(center: (874.8, 444.9), radius: 32.0), kind: Maple),
                (area: Round(center: (790.0, 425.0), radius: 32.0), kind: Maple),
                (area: Road(span: Span(5821.0, 360.0), reach: 24.0), kind: Cherry),
            ],
            // The fields of flowers, as on the hills of Tsushima and round
            // the lakes at the foot of Mount Fuji, over most of the island;
            // where they overlap, the first one listed.
            flowers: [
                // White round the great maple, for its reds to stand out.
                (area: Round(center: (875.4, 479.9), inner: 0.0, outer: 60.0), kinds: [White]),
                // Red spider lilies on the lake's open shore, seen across the
                // water.
                (area: Round(center: (836.0, 100.0), inner: 0.0, outer: 60.0), kinds: [SpiderLily]),
                // All round the lake, from its water up to the road's fence
                // (from 4 m inside its shore at its most wandering): carpets
                // of moss phlox in drifts of magenta, pink, lavender and
                // white.
                (area: Round(center: (870.0, 270.0), inner: 138.0, outer: 175.0), kinds: [Phlox]),
                // A meadow of red spider lilies beside the castle street.
                (area: Round(center: (110.0, -150.0), inner: 0.0, outer: 110.0), kinds: [SpiderLily]),
                // The susuki hills, golden with susuki either side of the
                // road, from its walls out.
                (area: Road(span: Span(1800.0, 2650.0), near: 11.5, far: 150.0), kinds: [Susuki]),
                // Yellow rape blossom and white flowers up the slopes over
                // the coast.
                (area: Road(span: Span(700.0, 1400.0), near: 11.5, far: 120.0), kinds: [Yellow, White]),
                // And everywhere else, in broad swathes.
                (area: Everywhere, kinds: [Phlox, SpiderLily, Yellow, White, Iris]),
            ],
        )),
    ),
