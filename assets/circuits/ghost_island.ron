            (center: (300.0, -530.0), radius: 230.0, height: 42.0, climbed: true),
            (center: (600.0, -460.0), radius: 260.0, height: 48.0, climbed: true),
            // The susuki hills.
            (center: (1040.0, -330.0), radius: 300.0, height: 36.0, climbed: true),
            (center: (1050.0, 20.0), radius: 240.0, height: 34.0, climbed: true),
            // The hill of the great maple, rising from the road round the foot of
