            (center: (-170.0, -430.0), radius: 190.0, height: 46.0, climbed: true),
            (center: (-200.0, -230.0), radius: 150.0, height: 22.0, climbed: true),
            // Crags on the red ridge, away from the road.
            (center: (520.0, -330.0), radius: 40.0, height: 22.0),
            (center: (800.0, -420.0), radius: 45.0, height: 24.0),
            // Stacks of rock standing in the sea off the coast road, and the islet
            // of the great torii.
            (center: (300.0, -950.0), radius: 28.0, height: 16.0),
            (center: (497.0, -892.0), radius: 20.0, height: 10.0),
        ],
        cuttings: [
            // The rock over the tunnel under the castle, from up the hill's
            // slope, and the rock the road is cut through out of its mouth by
