            corridors: [(span: Span(3830.0, 4120.0), every: 6.0, approach: 30.0, approach_every: 15.0)],
            // The props of feudal Japan, made with Meshy: landmarks out in
            // the open, and statues, lanterns, shrines and houses by the
            // road.
            props: [
                // The great torii on its islet in the sea off the coast road, facing
