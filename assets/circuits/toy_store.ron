        banking: [
            (from: 0.0, to: 730.1, factor: 1.5, raised: true),
            (from: 730.1, to: 914.2, factor: 0.0),
            (from: 914.2, to: 1053.0, factor: 1.5, raised: true),
            (
                from: 1053.0,
                to: 1348.0,
