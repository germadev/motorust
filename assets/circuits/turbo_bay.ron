            (73.0, 424.0),
            (38.0, 390.0),
            (16.0, 340.0),
            (6.0, 280.0),
            (8.0, 195.0),
            (6.0, 115.0),
            (2.0, 50.0),
        ],
        // Up and down all the way: from the seafront to the water's edge, up
