// La Bahía: la primera pista, inspirada en Speed Bay a la mediterránea. Una
// carretera de costa con muros de piedra, farolas, paredes de roca cortada,
// pinos piñoneros, cipreses, olivos y casas encaladas, con el mar al oeste y
// al sur y montañas al noreste.
//
// How a circuit's file is written: see src/circuits/data.rs. Its coast and
// mountains are functions, in src/circuits/bay.rs.
(
    name: "Bahía GP",
    name_en: "Bahía GP",
    description: "Una carretera junto al mar, con cuestas, peraltes\ny un salto en la recta de meta",
    description_en: "A seaside road with slopes, banked turns\nand a jump on the main straight",
    // A seaside road: the sea and its gulls, a few birds in the pines.
    ambience: (
        sea: 0.8,
        gulls: 0.7,
        birds: 0.3,
        cicadas: 0.2,
        wind: 0.2,
